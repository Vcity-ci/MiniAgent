# Optional startup defaults. Settings made in the web UI are memory-only.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
AGENT_THINKING=0
AGENT_ONLINE=0
AGENT_MAX_STEPS=10
AGENT_PROFILE_AUTO=1

# Optional paths
# AGENT_DATA_DIR=./data
# AGENT_LOG_DIR=./logs
# AGENT_CA_BUNDLE=C:\path\to\ca-bundle.pem
